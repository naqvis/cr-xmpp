<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
         xmlns='http://usefulinc.com/ns/doap#'
         xmlns:xmpp='https://linkmauve.fr/ns/xmpp-doap#'
         xmlns:schema='https://schema.org/'>
  <Project>
    <name>cr-xmpp</name>

    <shortdesc xml:lang='en'>XMPP/Jabber library for Crystal</shortdesc>

    <description xml:lang='en'>A pure-Crystal, event-driven toolkit for building XMPP clients, bots, automation services, connected devices, gateways, and XEP-0114 external components. It manages the wire protocol and connection lifecycle while exposing XMPP through typed, extensible Crystal APIs.</description>

    <homepage rdf:resource='https://github.com/naqvis/cr-xmpp'/>
    <schema:documentation rdf:resource='https://naqvis.github.io/cr-xmpp/'/>
    <bug-database rdf:resource='https://github.com/naqvis/cr-xmpp/issues'/>

    <license rdf:resource='https://github.com/naqvis/cr-xmpp/blob/master/LICENSE'/>

    <programming-language>Crystal</programming-language>

    <os>Linux</os>
    <os>macOS</os>
    <os>Windows</os>

    <category rdf:resource='https://linkmauve.fr/ns/xmpp-doap#category-library'/>

    <repository>
      <GitRepository>
        <browse rdf:resource='https://github.com/naqvis/cr-xmpp'/>
        <location rdf:resource='https://github.com/naqvis/cr-xmpp.git'/>
      </GitRepository>
    </repository>

    <implements rdf:resource='https://xmpp.org/rfcs/rfc6120.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc6121.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc7590.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc7395.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc5802.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc7677.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc4013.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc4505.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc4616.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc2831.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc5929.html'/>
    <implements rdf:resource='https://xmpp.org/rfcs/rfc9266.html'/>

    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource='https://xmpp.org/extensions/xep-0030.html'/>
        <xmpp:status>complete</xmpp:status>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource='https://xmpp.org/extensions/xep-0045.html'/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:note xml:lang='en'>MUC presence and history payloads; no room administration or configuration.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
